# Server-side environment. Web and worker require DATABASE_URL at startup, not build.
# Never prefix secrets with NEXT_PUBLIC_. NODE_ENV is set by Next.js; worker defaults to development.
# Local PostgreSQL. Run pnpm db:env to create an ignored .env with random passwords.
# These URLs contain placeholders, not usable credentials. Never commit real .env values.
POSTGRES_PORT=15432
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lifeos:replace-me@127.0.0.1:15432/lifeos

# Separate test instance and database. Never point tests at the application database.
POSTGRES_TEST_PORT=15433
POSTGRES_TEST_PASSWORD=
TEST_DATABASE_URL=postgresql://lifeos_test:replace-me@127.0.0.1:15433/lifeos_test

# Optional worker-specific namespace. Default: pgboss. Use a dedicated schema.
WORKER_QUEUE_SCHEMA=pgboss

# Better Auth (LFS-201). Web requires these at startup, not at build time.
# BETTER_AUTH_SECRET: 32+ random characters, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the Web app (scheme + host + port, no path). https in production.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Closed registration: comma-separated emails allowed to create an account (case-insensitive).
# Empty means nobody can sign up. Existing users can always sign in.
AUTH_SIGNUP_ALLOWLIST=

# Email delivery for password reset.
# outbox (development/test only): each message is a JSON file in MAIL_OUTBOX_DIR (relative to apps/web).
# smtp (required in production): SMTP_URL=smtps://user:password@smtp.example.com:465 or smtp://...:587 (STARTTLS).
MAIL_TRANSPORT=outbox
MAIL_FROM=no-reply@lifeos.local
MAIL_OUTBOX_DIR=../../.cache/dev-mail
# SMTP_URL=
