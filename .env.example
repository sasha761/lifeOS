# Server-side environment. Web and worker require DATABASE_URL at startup, not build.
# Never prefix secrets with NEXT_PUBLIC_. NODE_ENV is set by Next.js; worker defaults to development.
# Local PostgreSQL. Run pnpm db:env to create an ignored .env with random passwords.
# These URLs contain placeholders, not usable credentials. Never commit real .env values.
POSTGRES_PORT=15432
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lifeos:replace-me@127.0.0.1:15432/lifeos

# Separate test instance and database. Never point tests at the application database.
POSTGRES_TEST_PORT=15433
POSTGRES_TEST_PASSWORD=
TEST_DATABASE_URL=postgresql://lifeos_test:replace-me@127.0.0.1:15433/lifeos_test

# Optional worker-specific namespace. Default: pgboss. Use a dedicated schema.
WORKER_QUEUE_SCHEMA=pgboss
