      },
      "policies": {},
      "checkConstraints": {
        "goals_domain_key_check": {
          "name": "goals_domain_key_check",
          "value": "\"goals\".\"domain_key\" IN ('languages', 'finance', 'work', 'projects', 'skills', 'health')"
        },
        "goals_title_check": {
          "name": "goals_title_check",
          "value": "char_length(\"goals\".\"title\") BETWEEN 1 AND 200 AND btrim(\"goals\".\"title\") <> ''"
        },
        "goals_description_check": {
          "name": "goals_description_check",
          "value": "\"goals\".\"description\" IS NULL OR (char_length(\"goals\".\"description\") BETWEEN 1 AND 4000 AND btrim(\"goals\".\"description\") <> '')"
        },
        "goals_unit_check": {
          "name": "goals_unit_check",
          "value": "\"goals\".\"unit\" IN ('NOK', 'count', 'minutes', 'percent', 'custom')"
        },
        "goals_unit_label_check": {
          "name": "goals_unit_label_check",
          "value": "CASE WHEN \"goals\".\"unit\" = 'custom' THEN \"goals\".\"unit_label\" IS NOT NULL AND char_length(\"goals\".\"unit_label\") BETWEEN 1 AND 40 AND btrim(\"goals\".\"unit_label\") <> '' ELSE \"goals\".\"unit_label\" IS NULL END"
        },
        "goals_values_check": {
          "name": "goals_values_check",
          "value": "\"goals\".\"baseline\" >= 0 AND \"goals\".\"target\" >= 0 AND \"goals\".\"baseline\" < power(10::numeric, 22) AND \"goals\".\"target\" < power(10::numeric, 22) AND \"goals\".\"baseline\" = trunc(\"goals\".\"baseline\", 8) AND \"goals\".\"target\" = trunc(\"goals\".\"target\", 8)"
        },
        "goals_unit_values_check": {
          "name": "goals_unit_values_check",
          "value": "CASE \"goals\".\"unit\" WHEN 'NOK' THEN \"goals\".\"baseline\" = trunc(\"goals\".\"baseline\", 2) AND \"goals\".\"target\" = trunc(\"goals\".\"target\", 2) WHEN 'count' THEN \"goals\".\"baseline\" = trunc(\"goals\".\"baseline\") AND \"goals\".\"target\" = trunc(\"goals\".\"target\") WHEN 'percent' THEN \"goals\".\"baseline\" <= 100 AND \"goals\".\"target\" <= 100 ELSE true END"
        },
        "goals_direction_check": {
          "name": "goals_direction_check",
          "value": "(\"goals\".\"direction\" = 'increase' AND \"goals\".\"target\" > \"goals\".\"baseline\") OR (\"goals\".\"direction\" = 'decrease' AND \"goals\".\"target\" < \"goals\".\"baseline\")"
        },
        "goals_manual_check": {
          "name": "goals_manual_check",
          "value": "\"goals\".\"calculation_mode\" = 'manual' AND \"goals\".\"metric_key\" IS NULL"
        },
        "goals_status_check": {
          "name": "goals_status_check",
          "value": "\"goals\".\"status\" IN ('active', 'archived')"
        },
        "goals_due_at_check": {
          "name": "goals_due_at_check",
          "value": "\"goals\".\"due_at\" IS NULL OR (isfinite(\"goals\".\"due_at\") AND EXTRACT(YEAR FROM \"goals\".\"due_at\" AT TIME ZONE 'UTC') BETWEEN 1 AND 9999)"
        },
        "goals_timestamps_check": {
          "name": "goals_timestamps_check",
          "value": "isfinite(\"goals\".\"created_at\") AND isfinite(\"goals\".\"updated_at\") AND EXTRACT(YEAR FROM \"goals\".\"created_at\" AT TIME ZONE 'UTC') BETWEEN 1 AND 9999 AND EXTRACT(YEAR FROM \"goals\".\"updated_at\" AT TIME ZONE 'UTC') BETWEEN 1 AND 9999"
