      "checkConstraints": {
        "activity_events_type_check": {
          "name": "activity_events_type_check",
          "value": "\"activity_events\".\"event_type\" IN ('goal.created', 'goal.updated', 'goal.archived', 'goal_measurement.created', 'goal_measurement.updated', 'goal_measurement.deleted')"
        },
        "activity_events_source_check": {
          "name": "activity_events_source_check",
          "value": "\"activity_events\".\"source\" IN ('manual', 'web', 'telegram', 'import', 'ai_proposed')"
        },
        "activity_events_target_check": {
          "name": "activity_events_target_check",
          "value": "CASE WHEN \"activity_events\".\"event_type\" LIKE 'goal.%' THEN \"activity_events\".\"target_type\" = 'goal' AND \"activity_events\".\"target_id\" = \"activity_events\".\"goal_id\" ELSE \"activity_events\".\"target_type\" = 'goal_measurement' END"
        },
        "activity_events_key_check": {
          "name": "activity_events_key_check",
          "value": "\"activity_events\".\"idempotency_key\" IS NULL OR (char_length(\"activity_events\".\"idempotency_key\") BETWEEN 1 AND 128 AND \"activity_events\".\"idempotency_key\" !~ '[^A-Za-z0-9._:-]')"
        },
        "activity_events_version_check": {
          "name": "activity_events_version_check",
          "value": "\"activity_events\".\"schema_version\" = 1"
        },
        "activity_events_time_check": {
          "name": "activity_events_time_check",
          "value": "isfinite(\"activity_events\".\"occurred_at\") AND isfinite(\"activity_events\".\"created_at\")"
        },
        "activity_events_payload_check": {
          "name": "activity_events_payload_check",
          "value": "jsonb_typeof(\"activity_events\".\"payload\") = 'object' AND pg_column_size(\"activity_events\".\"payload\") <= 16384 AND \"activity_events\".\"payload\" ? 'before' AND \"activity_events\".\"payload\" ? 'after' AND \"activity_events\".\"payload\" - ARRAY['before','after','changed_fields'] = '{}'::jsonb"
        },
        "activity_events_before_fields_check": {
          "name": "activity_events_before_fields_check",
          "value": "\n    CASE WHEN \"activity_events\".\"payload\"->'before' = 'null'::jsonb THEN true\n    WHEN jsonb_typeof(\"activity_events\".\"payload\"->'before') = 'object' THEN\n      (\"activity_events\".\"payload\"->'before') - (CASE WHEN \"activity_events\".\"target_type\" = 'goal' THEN ARRAY['unit', 'baseline', 'target', 'direction', 'status', 'due_at'] ELSE ARRAY['value', 'measured_at', 'source'] END) = '{}'::jsonb\n    ELSE false END"
        },
        "activity_events_after_fields_check": {
          "name": "activity_events_after_fields_check",
          "value": "\n    CASE WHEN \"activity_events\".\"payload\"->'after' = 'null'::jsonb THEN true\n    WHEN jsonb_typeof(\"activity_events\".\"payload\"->'after') = 'object' THEN\n      (\"activity_events\".\"payload\"->'after') - (CASE WHEN \"activity_events\".\"target_type\" = 'goal' THEN ARRAY['unit', 'baseline', 'target', 'direction', 'status', 'due_at'] ELSE ARRAY['value', 'measured_at', 'source'] END) = '{}'::jsonb\n    ELSE false END"
        }
      },
