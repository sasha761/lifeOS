{
  "name": "@lifeos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:migrate:test": "node --env-file-if-exists=../../.env scripts/migrate-test.ts",
    "db:status": "node --env-file-if-exists=../../.env scripts/status.ts"
  },
  "dependencies": {
    "@lifeos/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@lifeos/contracts": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pg-boss": "12.38.1",
    "zod": "4.6.7"
  }
}
