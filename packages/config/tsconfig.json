{
  "extends": "./tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "eslint/**/*.ts", "*.config.ts"]
}
